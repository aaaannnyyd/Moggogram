 apply from: "$gradle.ext.androidxMediaSettingsDir/common_config.gradle"
-apply plugin: 'kotlin-android'
 android {
     namespace 'androidx.media3.effect'
 
@@ -23,10 +22,6 @@ android {
         }
     }
 
-    kotlinOptions {
-        jvmTarget = '1.8'
-    }
-
     sourceSets {
         androidTest.assets.srcDir '../test_data/src/test/assets/'
         test.assets.srcDir '../test_data/src/test/assets/'
diff --git a/libraries/exoplayer/build.gradle b/libraries/exoplayer/build.gradle
